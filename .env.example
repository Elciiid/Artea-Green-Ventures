# Copy to .env.local and fill in from your Supabase project
# (Dashboard → Project Settings → API). .env.local is gitignored.

# Public — safe to ship in the browser bundle (anon key is RLS-gated):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# The seed accounts' shared password (supabase/seed-users.mjs sets this on
# each one). Not used by any UI shortcut anymore (the account quick-switcher
# and one-click login rows were removed — see session.ts), but still needed
# to actually sign in as a seed account through the real login form.
NEXT_PUBLIC_DEV_SEED_PASSWORD=agv-dev-2026!

# Environment flag driving the demo banner. "production" hides it. Vercel
# sets its own VERCEL_ENV; this is the explicit override.
NEXT_PUBLIC_APP_ENV=development

# SERVICE ROLE KEY — for one-off scripts (supabase/seed-users.mjs), do NOT
# put this in .env.local or any committed/bundled file; pass it inline on
# that command from your own shell instead:
#   SUPABASE_URL=... SUPABASE_SERVICE_ROLE_KEY=... node supabase/seed-users.mjs
#
# For the running app itself, the signup API route
# (src/app/api/auth/signup/route.ts) needs this same key as a real runtime
# env var — client (non-AGV-domain) signups use Supabase's Admin API
# (auth.admin.createUser) to create an already-verified account with no
# email sent. Set it below in .env.local for dev, and in your host's
# project env vars for prod (e.g. Vercel → Settings → Environment
# Variables) — NOT prefixed NEXT_PUBLIC_, so it's never exposed to the
# browser. Still never paste the actual key into a chat session.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
